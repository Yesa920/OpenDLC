# 1) Copia este archivo con el nombre ".env"
# 2) Cambia las contrasenas por otras LARGAS (20 caracteres o mas, solo letras y numeros)
DB_NAME=pccomponentes
DB_USER=tienda
DB_PASS=CAMBIA_ESTA_CONTRASENA_LARGA
DB_ROOT_PASS=CAMBIA_ESTA_OTRA_CONTRASENA

# Correo que envia los avisos (codigo de recuperacion, compras, devoluciones).
# MAIL_PASS = "contrasena de aplicacion" de Google (16 letras, sin espacios), NO la de tu cuenta
MAIL_USER=tu_correo@gmail.com
MAIL_PASS=CONTRASENA_DE_APLICACION_DE_GOOGLE

# Clave secreta entre la web y el chatbot (40 caracteres o mas, solo letras y numeros)
CHAT_TOKEN=CAMBIA_ESTE_TOKEN_LARGO_DEL_CHAT

# IA gratuita del chatbot (opcional; si lo dejas vacio, el chatbot usa las respuestas por palabras clave)
# Opcion A - Gemini (clave gratis en aistudio.google.com/apikey):
IA_URL=https://generativelanguage.googleapis.com/v1beta/openai
IA_MODEL=gemini-2.5-flash
IA_KEY=TU_CLAVE_DE_GOOGLE_AI_STUDIO
# Opcion B - IA local con Ollama (sin clave): IA_URL=http://ollama:11434/v1  IA_MODEL=qwen2.5:3b  IA_KEY=
# Maximo de mensajes con IA al dia en total (protege la cuota gratuita)
IA_MAX_DIA=300

# Acceso de demostracion: 1 = el login muestra el boton "Entrar como cliente demo"
DEMO_MODE=1

# Solo para publicar en internet con HTTPS (docs/DESPLIEGUE_HTTPS.md): tu dominio, sin https://
# DOMINIO=tunombre.duckdns.org
